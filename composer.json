{
    "name": "easylawns/easylawns",
    "description": "easylawns — the easy lawn care guide. Static front end with PHP tooling and a built-in development server.",
    "type": "project",
    "license": "proprietary",
    "keywords": [
        "easylawns",
        "lawn-care",
        "gardening",
        "static-site",
        "php"
    ],
    "require": {
        "php": "^8.1"
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8000 -t . router.php",
        "serve:lan": "php -S 0.0.0.0:8000 -t . router.php",
        "lint": "php -l router.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
